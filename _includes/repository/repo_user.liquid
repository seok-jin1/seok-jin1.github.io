{% assign user = include.user | default: include.username %}
{% if user.username %}
  {% assign username = user.username %}
  {% assign display_name = user.name | default: user.username %}
  {% assign headline = user.headline %}
  {% assign description = user.description %}
  {% assign image = user.image %}
{% else %}
  {% assign username = user %}
  {% assign display_name = user %}
{% endif %}

{% if image %}
  {% if image contains '://' %}
    {% assign image_src = image %}
  {% else %}
    {% assign image_src = image | relative_url %}
  {% endif %}
{% endif %}

<div class="repo p-2">
  <a class="repo-card repo-card--user" href="https://github.com/{{ username }}" target="_blank" rel="noopener noreferrer">
    <div class="repo-card__media repo-card__media--portrait">
      {% if image_src %}
        <img src="{{ image_src }}" alt="{{ display_name }}" loading="lazy">
      {% endif %}
    </div>

    <div class="repo-card__body">
      <p class="repo-card__eyebrow">GitHub User</p>
      <h3 class="repo-card__title">{{ display_name }}</h3>
      <p class="repo-card__meta">@{{ username }}</p>
      {% if headline %}
        <p class="repo-card__headline">{{ headline }}</p>
      {% endif %}
      {% if description %}
        <p class="repo-card__description">{{ description }}</p>
      {% endif %}
    </div>
  </a>
</div>
