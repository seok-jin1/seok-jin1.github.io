{% assign repo = include.repo | default: include.repository %}
{% if repo.repository %}
  {% assign repository = repo.repository %}
  {% assign title = repo.title %}
  {% assign description = repo.description %}
  {% assign image = repo.image %}
  {% assign image_alt = repo.image_alt | default: repo.title %}
  {% assign image_fit = repo.image_fit | default: 'cover' %}
{% else %}
  {% assign repository = repo %}
{% endif %}

{% assign repo_url = repository | split: '/' %}
{% assign owner = repo_url[0] %}
{% assign repo_name = repo_url[1] %}

{% if title == null or title == '' %}
  {% assign title = repo_name %}
{% endif %}

{% if image %}
  {% if image contains '://' %}
    {% assign image_src = image %}
  {% else %}
    {% assign image_src = image | relative_url %}
  {% endif %}
{% endif %}

{% if image_fit == 'contain' %}
  {% assign media_class = 'repo-card__media repo-card__media--contain' %}
{% else %}
  {% assign media_class = 'repo-card__media' %}
{% endif %}

<div class="repo p-2">
  <a class="repo-card" href="https://github.com/{{ repository }}" target="_blank" rel="noopener noreferrer">
    <div class="{{ media_class }}">
      {% if image_src %}
        <img src="{{ image_src }}" alt="{{ image_alt }}" loading="lazy">
      {% else %}
        <div class="repo-card__placeholder">
          <span>{{ title }}</span>
        </div>
      {% endif %}
    </div>

    <div class="repo-card__body">
      <p class="repo-card__eyebrow">Repository</p>
      <h3 class="repo-card__title">{{ title }}</h3>
      <p class="repo-card__meta">{{ owner }}/{{ repo_name }}</p>
      {% if description %}
        <p class="repo-card__description">{{ description }}</p>
      {% endif %}
    </div>
  </a>
</div>
